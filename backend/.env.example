GRAPH_QL_ENDPOINT=https://example.fabric.microsoft.com/v1/workspaces/WORKSPACE_ID/graphqlapis/API_ID/graphql
FABRIC_AUTH_MODE=interactive
FABRIC_REQUEST_TIMEOUT=30
FABRIC_PAGE_SIZE=500
FABRIC_MAX_RECORDS=100000
FABRIC_CACHE_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

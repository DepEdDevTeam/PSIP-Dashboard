GRAPH_QL_ENDPOINT=https://example.fabric.microsoft.com/v1/workspaces/WORKSPACE_ID/graphqlapis/API_ID/graphql
FABRIC_AUTH_MODE=interactive
# Optional: pin local sign-in to your organization tenant.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
FABRIC_TOKEN_CACHE_NAME=psip-fabric-auth
FABRIC_REQUEST_TIMEOUT=30
FABRIC_PAGE_SIZE=500
FABRIC_MAX_RECORDS=100000
FABRIC_CACHE_SECONDS=1800
FABRIC_FETCH_WORKERS=4
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
